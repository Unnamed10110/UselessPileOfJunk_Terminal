<UserControl
    x:Class="UselessTerminal.Controls.SessionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:UselessTerminal.Controls"
    xmlns:conv="clr-namespace:UselessTerminal.Converters"
    MinWidth="0"
    HorizontalAlignment="Stretch"
    UseLayoutRounding="True"
    FontFamily="{DynamicResource Ui.FontFamily}"
    FontWeight="{DynamicResource Ui.FontWeight}"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextHintingMode="Fixed">

    <UserControl.Resources>
        <conv:HexColorConverter x:Key="HexColor" />
        <conv:SavedSessionShellIconConverter x:Key="SessionShellIcon" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="SessionRowHover" Color="#12ffffff" />
        <SolidColorBrush x:Key="SessionIndentGuide" Color="#1a2030" />

        <Style x:Key="SessionTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Ui.Foreground}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel HorizontalAlignment="Stretch">
                            <ContentPresenter x:Name="PART_Header"
                                              HorizontalAlignment="Stretch"
                                              ContentSource="Header"
                                              Margin="0,2" />
                            <Border x:Name="ChildrenBorder" Margin="14,0,0,0"
                                    BorderBrush="{DynamicResource Ui.CardBorder}"
                                    BorderThickness="1,0,0,0" Padding="14,0,0,0">
                                <ItemsPresenter x:Name="ItemsHost" />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ChildrenBorder" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="ChildrenBorder" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type local:SessionTreeNode}" ItemsSource="{Binding Children}">
            <Grid HorizontalAlignment="Stretch" MinWidth="0" ClipToBounds="True">
                <!-- ═══ Folder card ═══ -->
                <Border MinHeight="32" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        CornerRadius="8" Padding="6,4,6,4" BorderThickness="0"
                        Background="Transparent"
                        BorderBrush="{DynamicResource Ui.CardBorder}"
                        MouseEnter="FolderCard_MouseEnter" MouseLeave="FolderCard_MouseLeave">
                    <Border.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="New session in folder" Click="ContextFolder_AddSession_Click"
                                      Tag="{Binding Folder.Id}" />
                            <MenuItem Header="Rename folder" Click="ContextFolder_Rename_Click"
                                      Tag="{Binding Folder.Id}" />
                            <MenuItem Header="Move folder up" Click="ContextFolder_MoveUp_Click"
                                      Tag="{Binding Folder.Id}" />
                            <MenuItem Header="Move folder down" Click="ContextFolder_MoveDown_Click"
                                      Tag="{Binding Folder.Id}" />
                            <Separator />
                            <MenuItem Header="Expand" Click="ContextFolder_Expand_Click"
                                      Tag="{Binding Folder.Id}" />
                            <MenuItem Header="Collapse" Click="ContextFolder_Collapse_Click"
                                      Tag="{Binding Folder.Id}" />
                            <Separator />
                            <MenuItem Header="Delete folder" Click="ContextFolder_Delete_Click"
                                      Tag="{Binding Folder.Id}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Folder">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                             Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Ui.FolderSelectedBackground}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel HorizontalAlignment="Stretch" MinWidth="0" LastChildFill="True">
                        <StackPanel x:Name="FolderActionsPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" Opacity="0">
                            <Button Click="AddSessionInFolder_Click" Tag="{Binding Folder.Id}"
                                    ToolTip="New session in folder" Background="Transparent" BorderThickness="0"
                                    Padding="4,3" Cursor="Hand" Foreground="{DynamicResource Ui.ForegroundMuted}">
                                <ui:SymbolIcon Symbol="Add24" FontSize="12" />
                            </Button>
                            <Button Click="RenameFolder_Click" Tag="{Binding Folder.Id}"
                                    ToolTip="Rename" Background="Transparent" BorderThickness="0"
                                    Padding="4,3" Cursor="Hand" Foreground="{DynamicResource Ui.ForegroundMuted}"
                                    Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            <Button Click="DeleteFolder_Click" Tag="{Binding Folder.Id}"
                                    ToolTip="Delete folder" Background="Transparent" BorderThickness="0"
                                    Padding="4,3" Cursor="Hand" Foreground="{DynamicResource Ui.ForegroundMuted}"
                                    Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        </StackPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="10" Background="#0Cffffff"
                                Padding="7,1" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Children.Count}" FontSize="10.5"
                                       Foreground="{DynamicResource Ui.ForegroundMuted}" />
                        </Border>
                        <ToggleButton DockPanel.Dock="Left" Width="26" Height="26"
                                      VerticalAlignment="Center" Margin="0,0,4,0"
                                      Background="Transparent" BorderThickness="0"
                                      Focusable="False" Cursor="Hand"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Mode=TwoWay}">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource Ui.ForegroundMuted}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE76C;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                                         Value="True">
                                                <Setter Property="Text" Value="&#xE70D;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ToggleButton>
                        <StackPanel Orientation="Horizontal" MinWidth="0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Ui.FontSize}"
                                       Foreground="{DynamicResource Ui.Accent}" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.9" />
                            <TextBlock Text="{Binding Folder.Name}" FontWeight="{DynamicResource Ui.FontWeight}" FontSize="{DynamicResource Ui.FontSize}"
                                       Foreground="{DynamicResource Ui.Foreground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ═══ Session card ═══ -->
                <Border CornerRadius="8" Padding="10,8" MinHeight="50" HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        ToolTipService.InitialShowDelay="0"
                        ToolTipService.BetweenShowDelay="0"
                        ToolTipService.ShowDuration="60000">
                    <Border.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Open" Click="ContextSession_Open_Click" Tag="{Binding Session.Id}" />
                            <MenuItem Header="Run as administrator" Click="ContextSession_RunAsAdmin_Click"
                                      Tag="{Binding Session.Id}" />
                            <MenuItem Header="Edit" Click="ContextSession_Edit_Click" Tag="{Binding Session.Id}" />
                            <MenuItem Header="Duplicate" Click="ContextSession_Duplicate_Click" Tag="{Binding Session.Id}" />
                            <Separator />
                            <MenuItem Header="Delete" Click="ContextSession_Delete_Click" Tag="{Binding Session.Id}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Session">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="{Binding Session.ColorTag, Converter={StaticResource HexColor}}"
                                                             Opacity="0.15" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="BorderBrush">
                                        <Setter.Value>
                                            <SolidColorBrush Color="{Binding Session.ColorTag, Converter={StaticResource HexColor}}"
                                                             Opacity="0.4" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Kind}" Value="Session" />
                                        <Condition Binding="{Binding Session.HasDescription}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <ToolTip Background="{DynamicResource Ui.CardBackground}" BorderBrush="{DynamicResource Ui.CardBorder}"
                                                     BorderThickness="1" Padding="12,10" MaxWidth="320">
                                                <TextBlock Text="{Binding Session.Description}"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource Ui.Foreground}" />
                                            </ToolTip>
                                        </Setter.Value>
                                    </Setter>
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                             Value="True">
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="{Binding Session.ColorTag, Converter={StaticResource HexColor}}"
                                                             Opacity="0.28" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Kind}" Value="Session" />
                                        <Condition Binding="{Binding IsMultiSelected}" Value="True" />
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                                   Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel HorizontalAlignment="Stretch" MinWidth="0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Click="EditSession_Click" Tag="{Binding Session.Id}"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="4,3" Cursor="Hand" Foreground="{DynamicResource Ui.ForegroundMuted}"
                                    ToolTip="Edit" Content="&#xE70F;"
                                    FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            <Button Click="DeleteSession_Click" Tag="{Binding Session.Id}"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="4,3" Cursor="Hand" Foreground="{DynamicResource Ui.ForegroundMuted}"
                                    ToolTip="Delete" Content="&#xE74D;"
                                    FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        </StackPanel>
                        <Ellipse DockPanel.Dock="Right" Width="6" Height="6" VerticalAlignment="Center"
                                 Margin="0,0,6,0" Fill="{DynamicResource Ui.Success}"
                                 Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}" />
                        <Ellipse DockPanel.Dock="Left" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding Session.ColorTag, Converter={StaticResource HexColor}}" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <Image DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0"
                               Width="20" Height="20" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding Session, Converter={StaticResource SessionShellIcon}}" />
                        <Grid MinWidth="0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding Session.Name}" FontSize="{DynamicResource Ui.FontSize}" FontWeight="{DynamicResource Ui.FontWeight}"
                                       Foreground="{DynamicResource Ui.Foreground}" TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                            <TextBlock Grid.Row="1" Text="{Binding Session.DisplayCommand}" FontSize="{DynamicResource Ui.FontSizeSmall}"
                                       Foreground="{DynamicResource Ui.ForegroundMuted}" TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       Margin="0,2,0,0" Opacity="0.92" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Ui.ChromeBackground}" MinWidth="0" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14,12" Background="{DynamicResource Ui.ChromeBackground}"
                BorderBrush="{DynamicResource Ui.CardBorder}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="Sessions" FontSize="{DynamicResource Ui.FontSizeTitle}" FontWeight="{DynamicResource Ui.FontWeight}"
                           Foreground="{DynamicResource Ui.Accent}" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="AddSession_Click"
                            ToolTip="New Session (Ctrl+Shift+N)"
                            Height="30" Padding="10,0,10,0" Margin="0,0,6,0"
                            Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="PillBorder" CornerRadius="7"
                                        Background="{DynamicResource Ui.AccentDim}"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="13" Foreground="{DynamicResource Ui.Accent}"
                                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="New" Foreground="{DynamicResource Ui.Accent}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="PillBorder" Property="Opacity" Value="0.85" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="PillBorder" Property="Opacity" Value="0.7" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="MoreMenuButton" Click="MoreMenu_Click"
                            ToolTip="More"
                            Background="Transparent" BorderThickness="0"
                            Padding="6,4" Cursor="Hand" Foreground="{DynamicResource Ui.Icon}">
                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="14" />
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="Export sessions…" Click="ExportSessions_Click" />
                                <MenuItem Header="Import sessions…" Click="ImportSessions_Click" />
                                <MenuItem Header="New folder" Click="AddFolderRoot_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Padding="10,8,10,6">
            <Border x:Name="SearchBoxBorder" CornerRadius="8" BorderBrush="{DynamicResource Ui.CardBorder}" BorderThickness="1" Background="{DynamicResource Ui.InputBackground}" Padding="0">
                <DockPanel LastChildFill="True">
                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Search24" FontSize="13"
                                   Foreground="{DynamicResource Ui.ForegroundMuted}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox"
                             TextChanged="SearchBox_TextChanged"
                             GotFocus="SearchBox_GotFocus"
                             LostFocus="SearchBox_LostFocus"
                             Background="Transparent" Foreground="{DynamicResource Ui.InputForeground}"
                             BorderThickness="0"
                             Padding="8,8,10,8" FontSize="12"
                             CaretBrush="{DynamicResource Ui.Foreground}" />
                </DockPanel>
            </Border>
        </Border>

        <TreeView x:Name="SessionTree" Grid.Row="2"
                  Background="{DynamicResource Ui.ChromeBackground}" BorderThickness="0"
                  Padding="8,6,10,10"
                  HorizontalContentAlignment="Stretch"
                  UseLayoutRounding="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ItemContainerStyle="{StaticResource SessionTreeViewItemStyle}"
                  AllowDrop="True"
                  PreviewMouseLeftButtonDown="SessionTree_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="SessionTree_PreviewMouseMove"
                  PreviewMouseLeftButtonUp="SessionTree_PreviewMouseLeftButtonUp"
                  DragOver="SessionTree_DragOver"
                  Drop="SessionTree_Drop"
                  SelectedItemChanged="SessionTree_SelectedItemChanged"
                  MouseDoubleClick="SessionTree_MouseDoubleClick">
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="New session" Click="ContextTree_NewSession_Click" />
                    <MenuItem Header="New folder" Click="ContextTree_NewFolder_Click" />
                    <Separator />
                    <MenuItem Header="Import from Windows Terminal" Click="ContextTree_ImportWt_Click" />
                    <MenuItem Header="Import from SSH Config" Click="ContextTree_ImportSsh_Click" />
                    <Separator />
                    <MenuItem Header="Export sessions…" Click="ContextTree_ExportSessions_Click" />
                    <MenuItem Header="Import sessions…" Click="ContextTree_ImportSessions_Click" />
                </ContextMenu>
            </TreeView.ContextMenu>
        </TreeView>

        <!-- Snippets -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource Ui.CardBorder}" BorderThickness="0,1,0,0"
                Background="{DynamicResource Ui.ChromeBackground}">
            <StackPanel>
                <DockPanel Margin="14,10,14,4">
                    <TextBlock Text="Snippets" FontSize="{DynamicResource Ui.FontSize}" FontWeight="{DynamicResource Ui.FontWeight}"
                               Foreground="{DynamicResource Ui.Highlight}" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Click="ToggleSnippets_Click"
                                ToolTip="Toggle snippets"
                                Background="Transparent" BorderThickness="0"
                                Padding="6,4" Cursor="Hand" Foreground="{DynamicResource Ui.Icon}">
                            <TextBlock x:Name="SnippetToggleGlyph" Text="&#xE70D;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                        <Button Click="AddSnippet_Click"
                                ToolTip="Add snippet"
                                Background="Transparent" BorderThickness="0"
                                Padding="6,4" Cursor="Hand" Foreground="{DynamicResource Ui.Icon}">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                        </Button>
                    </StackPanel>
                </DockPanel>
                <ListBox x:Name="SnippetList" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource Ui.Foreground}" MaxHeight="200"
                         MouseDoubleClick="SnippetList_MouseDoubleClick"
                         Padding="8,0,8,6">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="SnipBd" CornerRadius="6" Padding="10,7"
                                                Background="Transparent">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="&#xE74D;"
                                                        FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource Ui.Error}" Click="SnippetDelete_Click"
                                                        Tag="{Binding}" Cursor="Hand"
                                                        Padding="4,2" VerticalAlignment="Center" />
                                                <StackPanel MinWidth="0">
                                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Ui.FontSizeSmall}"
                                                               Foreground="{DynamicResource Ui.Foreground}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Command}" FontSize="{DynamicResource Ui.FontSizeSmall}"
                                                               Foreground="{DynamicResource Ui.ForegroundMuted}" TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SnipBd" Property="Background" Value="{DynamicResource Ui.HoverBackground}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SnipBd" Property="Background" Value="{DynamicResource Ui.FolderSelectedBackground}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
