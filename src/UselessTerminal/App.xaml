<Application
    x:Class="UselessTerminal.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <!-- GDI-style hinting: WPF Ideal mode looks soft/fuzzy on chrome at 100–150% DPI. -->
            <Style TargetType="TextBlock">
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
            </Style>
            <Style TargetType="Window">
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
            </Style>
            <FontFamily x:Key="Ui.FontFamily">Segoe UI</FontFamily>
            <sys:Double x:Key="Ui.FontSize">13</sys:Double>
            <sys:Double x:Key="Ui.FontSizeSmall">11</sys:Double>
            <sys:Double x:Key="Ui.FontSizeTitle">15</sys:Double>
            <sys:Double x:Key="Ui.FontSizeTab">10</sys:Double>
            <sys:Double x:Key="Ui.FontSizeIcon">14</sys:Double>
            <FontWeight x:Key="Ui.FontWeight">Normal</FontWeight>
            <SolidColorBrush x:Key="Ui.Foreground" Color="#ffffff" />
            <SolidColorBrush x:Key="Ui.ForegroundMuted" Color="#888888" />
            <SolidColorBrush x:Key="Ui.Accent" Color="#6be5ff" />
            <SolidColorBrush x:Key="Ui.AccentDim" Color="#6be5ff" Opacity="0.14" />
            <SolidColorBrush x:Key="Ui.Highlight" Color="#c47cff" />
            <SolidColorBrush x:Key="Ui.Success" Color="#b4fb00" />
            <SolidColorBrush x:Key="Ui.Warning" Color="#ffef5c" />
            <SolidColorBrush x:Key="Ui.Error" Color="#ff2b7b" />
            <SolidColorBrush x:Key="Ui.ChromeBackground" Color="#000000" />
            <SolidColorBrush x:Key="Ui.CardBackground" Color="#0d1b1f" />
            <SolidColorBrush x:Key="Ui.CardBorder" Color="#1e4055" />
            <SolidColorBrush x:Key="Ui.FolderSelectedBackground" Color="#18323a" />
            <SolidColorBrush x:Key="Ui.TabForeground" Color="#ffffff" />
            <SolidColorBrush x:Key="Ui.TabSelectedBackground" Color="#6be5ff" />
            <SolidColorBrush x:Key="Ui.TabSelectedForeground" Color="#111111" />
            <SolidColorBrush x:Key="Ui.StatusBackground" Color="#11252a" />
            <SolidColorBrush x:Key="Ui.Icon" Color="#6be5ff" />
            <SolidColorBrush x:Key="Ui.InputBackground" Color="#121212" />
            <SolidColorBrush x:Key="Ui.InputForeground" Color="#ffffff" />
            <SolidColorBrush x:Key="Ui.HoverBackground" Color="#13292e" />
            <SolidColorBrush x:Key="Ui.Splitter" Color="#2e6773" />
            <SolidColorBrush x:Key="Ui.TerminalBackground" Color="#000000" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
